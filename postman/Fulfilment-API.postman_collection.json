  "item": [
    {
      "name": "Products",
      "description": "Baseline Product CRUD API. Run this folder in order to list and read seeded products, create a uniquely named product, update it, and finally delete it.",
      "item": [
        {
          "name": "List Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            },
            "description": "Returns all products sorted by name."
          },
          "response": []
        },
        {
          "name": "Get Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Requested product was returned\", function () {",
                  "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"productId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{productId}}"
              ]
            },
            "description": "Returns the product identified by `productId`. The default value `1` refers to seeded development data."
          },
          "response": []
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"productName\", \"POSTMAN-PRODUCT-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.id).to.exist;",
                  "    pm.collectionVariables.set(\"createdProductId\", String(product.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{productName}}\",\n  \"description\": \"Created from the Postman collection\",\n  \"price\": 12.50,\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            },
            "description": "Creates a product. Do not provide an `id`; the database generates it. The pre-request script generates a unique name, and the test script saves the response ID as `createdProductId`."
          },
          "response": []
        },
        {
          "name": "Update Created Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Product fields were updated\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.name).to.eql(pm.collectionVariables.get(\"productName\") + \"-UPDATED\");",
                  "    pm.expect(product.stock).to.eql(7);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{productName}}-UPDATED\",\n  \"description\": \"Updated from the Postman collection\",\n  \"price\": 15.75,\n  \"stock\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/product/{{createdProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{createdProductId}}"
              ]
            },
            "description": "Fully updates the product created by the preceding request. Run Create Product first so `createdProductId` is populated."
          },
          "response": []
        },
        {
          "name": "Delete Created Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/{{createdProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{createdProductId}}"
              ]
            },
            "description": "Deletes the product created during this workflow."
          },
          "response": []
        }
      ]
    },
