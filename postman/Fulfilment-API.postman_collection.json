              "raw": "{\n  \"businessUnitCode\": \"{{warehouseBusinessUnitCode}}\",\n  \"location\": \"ZWOLLE-002\",\n  \"capacity\": 20,\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
